# Bind locally until a TLS reverse proxy and access control are configured.
CHAPTERA_BIND=127.0.0.1
CHAPTERA_PORT=8000
CHAPTERA_DB_PATH=./data/jobs.sqlite3

# Required: a JSON object mapping team member IDs to their independent API tokens.
# Never commit real tokens. Generate each token with at least 32 random bytes.
CHAPTERA_TEAM_TOKENS_JSON='{"admin":"replace-with-a-random-secret","editor":"replace-with-another-secret"}'

CHAPTERA_GEMINI_API_KEY=replace-with-a-secret
CHAPTERA_GEMINI_MODEL=gemini-3.8-flash
CHAPTERA_WORKER_POLL_SECONDS=1.0
