# Bind locally until a TLS reverse proxy and access control are configured.
CHAPTERA_BIND=127.0.0.1
CHAPTERA_PORT=8000
CHAPTERA_DB_PATH=./data/jobs.sqlite3

# Required: a JSON object mapping team member IDs to their independent API tokens.
# Never commit real tokens. Generate each token with at least 32 random bytes.
CHAPTERA_TEAM_TOKENS_JSON='{"admin":"replace-with-a-random-secret","editor":"replace-with-another-secret"}'

CHAPTERA_GEMINI_API_KEY=replace-with-a-secret
CHAPTERA_GEMINI_MODEL=gemini-3.8-flash
# Native desktop Gemini scheduler defaults for this model, NOT universal limits.
# One API key from one project. Override when AI Studio/model entitlement differs.
CHAPTERA_GEMINI_RPM=5
CHAPTERA_GEMINI_TPM=250000
CHAPTERA_GEMINI_RESERVED_OUTPUT_TOKENS=65536
# Optional conservative quota for this Google PROJECT + MODEL, shared by all
# API keys of the same project. 0 means disabled; set the real project ID/name
# consistently on every worker sharing the same SQLite database.
# Example: 21 is NOT a universal Gemini limit. See AI Studio's live quota.
CHAPTERA_GEMINI_QUOTA_PROJECT=
CHAPTERA_GEMINI_REQUESTS_PER_DAY=0
# RPD resets at midnight America/Los_Angeles, not local/server midnight.
# Tokens per minute, requests per minute and spend limits are separate.

CHAPTERA_WORKER_POLL_SECONDS=1.0
